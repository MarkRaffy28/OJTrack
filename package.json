{
  "name": "ojtrack-workspace",
  "private": true,
  "scripts": {
    "app": "cd app && npx expo start",
    "backend": "cd backend && php artisan serve --host=0.0.0.0 --port=8000",
    "dev": "concurrently \"npm run app\" \"npm run backend\"",
    "diff": "git diff --staged > staged.diff"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
