
{
  "expo": {
    "name": "OJTrack",
    "slug": "ojtrack",
    "scheme": "ojtrack",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171717"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.ojtrack"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-camera",
      "expo-font",
      "expo-navigation-bar",
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0d352ad-503c-486b-8ead-ab9f3903e043"
      }
    }
  }
}
